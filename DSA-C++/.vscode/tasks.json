{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build and run c++",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "g++",
        "\"${file}\"",
        "-std=c++20",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-o",
        "\"${fileBasenameNoExtension}.exe\"",
        "&&",
        "\"${fileBasenameNoExtension}.exe\""
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
